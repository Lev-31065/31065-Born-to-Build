    private boolean guidingArms() {
        //Open
            if(armsTimer.seconds() < 1.5){
                 guideL.setPosition(0.097);
                guideR.setPosition(0.93);
            }
            //side
            if(armsTimer.seconds() > 1.5 && armsTimer.seconds() < 2.25){
                guideL.setPosition(0.097);
                guideR.setPosition(0.65);
            }//middle
            if(armsTimer.seconds() > 2.25 &&  armsTimer.seconds() < 2.75 ){
                 guideL.setPosition(0.13);
                guideR.setPosition(0.83);
            }
        
         //side
            if(armsTimer.seconds() > 2.75 && armsTimer.seconds() < 3.5){
                guideL.setPosition(0.4);
                guideR.setPosition(0.93);
            }
            //opem
            if(armsTimer.seconds() > 3.5 && armsTimer.seconds() < 4.5){
                 guideL.setPosition(0.097);
                guideR.setPosition(0.93);
                
            } else if(armsTimer.seconds() > 4.5){
                return true;
            }
            return false;
    } //end of guidingArms()

