     private void move(double xPos, double yPos, double hPos){


        speed = Math.abs(Math.abs((hPos - targetA)) / 35 + .1);
        ySpeed = Math.abs(Math.abs((yPos - targetY)) / 35 + 0.2);
        xSpeed = Math.abs(Math.abs((xPos - targetX)) / 35 + 0.2);
        
        if(rotationDegrees < targetA - 3){
                rotate = -.3 * speed;
                angleReached = false;
    
        }else if (rotationDegrees > targetA + 3){
            rotate = 0.3 * speed;
            angleReached = false;
        }else{
            rotate = 0;
            angleReached = true;
        }
   
        if(xPos > (targetX + xyMargin)){
            right = 1 * xSpeed * setSpeed;
            xReached = false;

        }
        else if(xPos < (targetX - xyMargin)){
            right = -1 * xSpeed * setSpeed;
             xReached = false;
        }else{
            right = 0;
            xReached = true;
        }
   
        //yPos self-correct positive (forward):
        if(yPos > (targetY +xyMargin)){
            forward =  1 * ySpeed * setSpeed;
            yReached = false;
        }
        else if(yPos < (targetY - xyMargin)){
            forward = - 1 * ySpeed * setSpeed;
            yReached = false;
        }else {
            forward = 0;
            yReached = true;
        }
   

        double theta = Math.atan2(forward, right);
        double r = Math.hypot(right, forward);
    
        // Second, rotate angle by the angle the robot is pointing
        theta = AngleUnit.normalizeRadians(theta -
                otosHeading); //imu.getRobotYawPitchRollAngles().getYaw(AngleUnit.RADIANS));
    
     // Third, convert back to cartesian
        double newForward = r * Math.sin(theta);
        double newRight = r * Math.cos(theta);  
        
        
        
        yAdjusted = yPos - yOffset;
        xAdjusted = xPos - xOffset;
        
        double frontLeftPower = newForward + newRight + rotate;
        double frontRightPower = newForward - newRight - rotate;
        double backRightPower = newForward + newRight - rotate;
        double backLeftPower = newForward - newRight + rotate;
        
        frontLeftDrive.setPower(frontLeftPower);
        frontRightDrive.setPower(frontRightPower);
        backLeftDrive.setPower(backLeftPower);
        backRightDrive.setPower(backRightPower);
                    
    }
    
    

