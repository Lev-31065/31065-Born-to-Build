                stopDriving();
                timer.reset();

            }
            
            //Launch catapults a second time
            if(stage == 11){
                
                //Eject
                muncher.setPower(-1);
                muncher2.setPower(-1);

                launchCatapults(catColors);

                muncher.setPower(0);
                muncher2.setPower(0);

                angleReached = false;
                runOnce = false;
                cBack = false;
                //  stage = 12;
                redundancy.reset();
                stage = 12;



            }

            //Pull the catpaults back and turn sideways
            if(stage == 12){
                targetA = -90;
                reloadCatapults();
                if(angleReached == true || redundancy.seconds() > 1.5){
                    // xReached = false;
                    yReached = false;
                    xReached = false;
                    stage = 13;
                    redundancy.reset();

                }
        
            }

            //Line up with the seconds set of artifacts
            if(stage == 13){


                //og
                xyMargin = 3;
                //pasted
                targetY = 10;
                targetX = 55;
//done

                if(cBack == false){
                    reloadCatapults();
                }
                if((xReached == true && yReached == true && cBack == true) || redundancy.seconds() > 1.5){

                    closeServos();
                    stopDriving();

                    sleep(800);

                    xReached = false;
                    yReached = false;
                    runOnce2 = false;

                    timer.reset();
                    redundancy.reset();
                    armsTimer.reset();
                    stage = 14;
                }
            }
            //intake the seconds set of artifacts
            if(stage == 14){

                setSpeed = 0.5;
                targetY = 45;
                targetX = 55;
                xyMargin = 3;

                if(runOnce2 = false && timer.seconds() > 1){
                    resetCatapultEncoders();
                    runOnce2 = true;
                }


                //intake
                muncher.setPower(1);
                muncher2.setPower(1);

                //Activates the guiding arms
                guideStage = 1;
                guidingArms();
                //Prepare catpaults for launching
                if(timer.seconds() > 1.5){
                    cPos = firingPower;
                }
                if((xReached && yReached && cat1.getCurrentPosition() >= cPosCorrected - 10 && timer.seconds() > 2.5) || redundancy.seconds() > 3){
                    stage = 15;
                    xyMargin = 2;
                    xReached = false;
                    yReached = false;
                    angleReached = false;
                    setSpeed = 1;
                    redundancy.reset();
                    timer.reset();

                }
            }
            //Return to the launch zone
            if(stage == 15){

                xyMargin = 2;

                targetX = 10;
                targetY = 0;
                targetA = 20;

                //Activates guiding arms
                guidingArms();

                if((xReached == true && yReached == true && angleReached == true && guidingArms() && timer.seconds() > 4) || redundancy.seconds() > 6)
                    xReached = false;
                yReached = false;
                angleReached = false;
                stopDriving();

                stage = 16;
                timer.reset();
                redundancy.reset();
                //Guiding arms open positions
                guideL.setPosition(0.097);
                guideR.setPosition(0.93);
            }

            if(stage == 16){
                closeServos();


                if(timer.seconds() > 2){
                    stage = 17;
                }

            }
            
            //Eject and launch
            if(stage == 17){

                override1 = false;
                muncher.setPower(-1);
                muncher2.setPower(-1);
                stopDriving();

                launchCatapults(catColors);
                sleep(500);

                stage = 18;
            }
            
            //Park and stop driving
            if(stage == 18 || runtime.seconds() > 27){
                if(finished == false){
                    finished = true;
                    yReached = false;
                    xReached = false;
                    angleReached = false;
                }
                targetA = 0;
