            if(stage == 9){
                targetY = 0;
               //Move the robot away from the wall
                targetX = 5;
                //Turn the robot towards the goal
                targetA = 19;

                guidingArms();


                if((xReached == true && yReached == true && angleReached == true && guidingArms() && timer.seconds() > 1.5) || redundancy.seconds() > 3){
