                muncher2.setPower(1);

                //Activates the guiding arms
                guideStage = 1;
                guidingArms();

                //Prepares catpaults for launching
                if(timer.seconds() > 1.5){
                    cPos = firingPower;
                }
                if((xReached && yReached && cat1.getCurrentPosition() >= cPosCorrected -10 && timer.seconds() > 2.5) || redundancy.seconds() > 4){
